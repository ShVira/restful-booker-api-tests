        {
          "name": "Get all booking ids",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Response is a list of booking ids\", () => {",
                  "    const list = pm.response.json();",
                  "    pm.expect(list).to.be.an(\"array\").and.not.empty;",
                  "    pm.expect(list[0]).to.have.property(\"bookingid\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ]
            }
          }
        },
        {
          "name": "Create booking",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set(\"firstname\", \"Anna\");",
                  "pm.environment.set(\"lastname\", \"Test\" + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test(\"Response has bookingid\", () => pm.expect(res.bookingid).to.be.a(\"number\"));",
                  "pm.test(\"Saved data matches request\", () => {",
                  "    pm.expect(res.booking.firstname).to.eql(pm.environment.get(\"firstname\"));",
                  "    pm.expect(res.booking.lastname).to.eql(pm.environment.get(\"lastname\"));",
                  "    pm.expect(res.booking.totalprice).to.eql(150);",
                  "    pm.expect(res.booking.bookingdates.checkin).to.eql(\"2026-12-01\");",
                  "});",
                  "pm.environment.set(\"bookingId\", res.bookingid);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"{{firstname}}\",\n  \"lastname\": \"{{lastname}}\",\n  \"totalprice\": 150,\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"2026-12-01\",\n    \"checkout\": \"2026-12-05\"\n  },\n  \"additionalneeds\": \"Breakfast\"\n}",
              "options": {
                "raw": {
                  "language": "json"
